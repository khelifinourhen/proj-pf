    {
      "id": 8,
      "title": "Alimentation Électrique (Tension & Courant)",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 16 },
      "targets": [
        {
          "query": "from(bucket: \"aircraft_telemetry\")\n  |> range(start: v.timeRangeStart, stop: v.timeRangeStop)\n  |> filter(fn: (r) => r._measurement =~ /^sensors(_ml)?$/)\n  |> filter(fn: (r) => r[\"_field\"] == \"voltage_v\" or r[\"_field\"] == \"current_a\")\n  |> aggregateWindow(every: v.windowPeriod, fn: mean, createEmpty: false)\n  |> yield(name: \"electrical\")",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": { "lineWidth": 2 }
        },
        "overrides": [
          {
            "matcher": { "id": "byName", "options": "voltage_v" },
            "properties": [
              { "id": "unit", "value": "volt" },
              { "id": "custom.axisPlacement", "value": "left" },
              { "id": "custom.axisLabel", "value": "Tension (V)" }
            ]
          },
          {
            "matcher": { "id": "byName", "options": "current_a" },
            "properties": [
              { "id": "unit", "value": "amp" },
              { "id": "custom.axisPlacement", "value": "right" },
              { "id": "custom.axisLabel", "value": "Courant (A)" }
            ]
          }
        ]
      }
    }
