  "links": [],
  "liveNow": true,
  "panels": [
    {
      "id": 1,
      "title": "Statut ML - NORMAL / ANOMALY",
      "type": "stat",
      "gridPos": { "h": 4, "w": 6, "x": 0, "y": 0 },
      "targets": [
        {
          "query": "from(bucket: \"aircraft_telemetry\")\n  |> range(start: v.timeRangeStart, stop: v.timeRangeStop)\n  |> filter(fn: (r) => r._measurement =~ /^sensors(_ml)?$/)\n  |> filter(fn: (r) => r[\"_field\"] == \"ml_status\")\n  |> group()\n  |> last()",
          "refId": "A"
        }
      ],
      "options": {
        "colorMode": "background",
        "graphMode": "none",
        "justifyMode": "auto",
        "reduceOptions": {
          "calcs": ["lastNotNull"],
          "fields": "",
          "values": false
        },
        "textMode": "auto"
      },
      "fieldConfig": {
        "defaults": {
          "mappings": [
            {
              "type": "value",
              "options": {
                "NORMAL": { "color": "green", "text": "NORMAL (Sain)", "index": 0 },
                "ANOMALY": { "color": "red", "text": "⚠️ ANOMALIE", "index": 1 }
              }
            }
          ]
        }
      }
    },
    {
      "id": 2,
      "title": "Score d'Anomalie (Isolation Forest)",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 6, "y": 0 },
      "targets": [
        {
          "query": "from(bucket: \"aircraft_telemetry\")\n  |> range(start: v.timeRangeStart, stop: v.timeRangeStop)\n  |> filter(fn: (r) => r._measurement =~ /^sensors(_ml)?$/)\n  |> filter(fn: (r) => r[\"_field\"] == \"ml_anomaly_score\")\n  |> aggregateWindow(every: v.windowPeriod, fn: mean, createEmpty: false)\n  |> yield(name: \"score\")",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "lineWidth": 2,
            "thresholdsStyle": { "mode": "line" }
          },
          "color": { "mode": "palette-classic" },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "orange", "value": 0.4 },
              { "color": "red", "value": 0.5244 }
            ]
          }
        }
      }
    },
    {
      "id": 3,
      "title": "RPM Moteur",
      "type": "gauge",
      "gridPos": { "h": 8, "w": 6, "x": 18, "y": 0 },
      "targets": [
        {
          "query": "from(bucket: \"aircraft_telemetry\")\n  |> range(start: v.timeRangeStart, stop: v.timeRangeStop)\n  |> filter(fn: (r) => r._measurement =~ /^sensors(_ml)?$/)\n  |> filter(fn: (r) => r[\"_field\"] == \"rpm\")\n  |> group()\n  |> last()",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "rotrpm",
          "min": 0,
          "max": 6000,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "orange", "value": 3000 },
              { "color": "red", "value": 4500 }
            ]
          }
        }
      }
    },
    {
      "id": 4,
      "title": "Nombre d'Anomalies Détectées",
      "type": "stat",
      "gridPos": { "h": 4, "w": 6, "x": 0, "y": 4 },
      "targets": [
        {
          "query": "from(bucket: \"aircraft_telemetry\")\n  |> range(start: v.timeRangeStart, stop: v.timeRangeStop)\n  |> filter(fn: (r) => r._measurement =~ /^sensors(_ml)?$/)\n  |> filter(fn: (r) => r[\"_field\"] == \"ml_anomaly\" and (r[\"_value\"] == 1 or r[\"_value\"] == 1.0 or r[\"_value\"] == \"1\" or r[\"_value\"] == true))\n  |> group()\n  |> count()",
          "refId": "A"
        }
      ],
      "options": {
        "colorMode": "background",
        "graphMode": "area",
        "reduceOptions": {
          "calcs": ["lastNotNull"],
          "values": false
        }
      },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "orange", "value": 1 },
              { "color": "red", "value": 5 }
            ]
          }
        }
      }
    },
    {
      "id": 5,
      "title": "Température Capteur (°C)",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 8 },
      "targets": [
        {
          "query": "from(bucket: \"aircraft_telemetry\")\n  |> range(start: v.timeRangeStart, stop: v.timeRangeStop)\n  |> filter(fn: (r) => r._measurement =~ /^sensors(_ml)?$/)\n  |> filter(fn: (r) => r[\"_field\"] == \"temperature_c\" or r[\"_field\"] == \"temperature\")\n  |> aggregateWindow(every: v.windowPeriod, fn: mean, createEmpty: false)\n  |> yield(name: \"temp\")",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "celsius",
          "custom": { "lineWidth": 2 },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "orange", "value": 65 },
              { "color": "red", "value": 90 }
            ]
          }
        }
      }
    },
    {
      "id": 6,
      "title": "Pression Atmosphérique (hPa)",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 8 },
      "targets": [
        {
          "query": "from(bucket: \"aircraft_telemetry\")\n  |> range(start: v.timeRangeStart, stop: v.timeRangeStop)\n  |> filter(fn: (r) => r._measurement =~ /^sensors(_ml)?$/)\n  |> filter(fn: (r) => r[\"_field\"] == \"pressure_hpa\" or r[\"_field\"] == \"pressure\")\n  |> aggregateWindow(every: v.windowPeriod, fn: mean, createEmpty: false)\n  |> yield(name: \"pressure\")",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "hPa",
          "custom": { "lineWidth": 2 }
        }
