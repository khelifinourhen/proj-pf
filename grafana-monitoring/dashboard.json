      "targets": [
        {
          "query": "from(bucket: \"aircraft_telemetry\")\n  |> range(start: v.timeRangeStart, stop: v.timeRangeStop)\n  |> filter(fn: (r) => r._measurement =~ /^sensors(_ml)?$/)\n  |> filter(fn: (r) => r[\"_field\"] == \"vibration_norm_ms2\" or r[\"_field\"] == \"accX\")\n  |> aggregateWindow(every: v.windowPeriod, fn: mean, createEmpty: false)\n  |> yield(name: \"vib\")",
          "refId": "A"
